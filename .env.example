# Copy to .env for local overrides (optional for Docker Compose — defaults exist).
# Host/pytest: keep a local sqlite URL. Compose api/worker override DATABASE_URL
# to the in-stack Postgres service regardless of this value.

# PostgreSQL (Compose service credentials)
POSTGRES_USER=sas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sas
# Local process default (pytest / python main.py outside Compose):
DATABASE_URL=sqlite:///./sas_mvp.db

# RabbitMQ / Celery (host-side defaults; Compose rebuilds URLs for containers)
RABBITMQ_DEFAULT_USER=sas
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_URL=amqp://sas:change_me@localhost:5672//
CELERY_BROKER_URL=amqp://sas:change_me@localhost:5672//
# CELERY_RESULT_BACKEND=db+postgresql+psycopg2://sas:change_me@localhost:5432/sas

# Spectrum / runtime
SAS_PROFILE=cbrs_winnforum
# Optional NTIA DPA KML paths (os.pathsep-separated). Default: data/ntia/ then sibling harness.
# SAS_DPA_KML_PATHS=/path/to/E-DPAs.kml:/path/to/P-DPAs.kml
# production: CPAS via Celery/RabbitMQ; certification: same pipeline inline (no broker)
SAS_EXECUTION_MODE=production
SAS_ADMIN_ID=sas_admin_id
FAD_PUBLIC_BASE=https://localhost:9000
SAS_SAS_VERSION=v1.3
HTTP_TIMEOUT_SECONDS=30
MAX_BATCH_SIZE=100

# API listeners
API_HOST=0.0.0.0
RSA_PORT=9000
ECC_PORT=9001

# Canonical certificate directory for the SAS process.
# On the host, provision ./certs (gitignored). Docker Compose mounts
# CERTS_HOST_DIR into CERTS_DIR inside the container.
# Required: server.cert/server.key, server-ecc.cert/server-ecc.key, ca.cert, crl/*.crl.pem
CERTS_HOST_DIR=./certs
CERTS_DIR=/certs

# External federal / marketplace DB basic auth
DB_SYNC_USERNAME=username
DB_SYNC_PASSWORD=change_me

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
